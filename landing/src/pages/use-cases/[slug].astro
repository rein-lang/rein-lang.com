---
import Base from "../../layouts/Base.astro";
import FlowDiagram from "../../components/FlowDiagram.astro";
import { SITE_URL, GET_STARTED_HREF } from "../../../site.config.mjs";
import { useCases, type UseCase } from "../../data/useCases";
import { breadcrumbs, website } from "../../data/structuredData";

export function getStaticPaths() {
  return useCases.map((useCase) => ({ params: { slug: useCase.slug }, props: { useCase } }));
}

const { useCase } = Astro.props as { useCase: UseCase };
const path = `/use-cases/${useCase.slug}/`;
const related = useCases.filter((u) => u.slug !== useCase.slug);
const installLines = `${useCase.installCommand ?? "rein install -g <package>"}\nrein list`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: useCase.title,
    description: useCase.description,
    url: new URL(path, SITE_URL).href,
    isPartOf: website,
  },
  breadcrumbs([
    ["Use cases", "/use-cases/"],
    [useCase.h1, path],
  ]),
];
---

<Base title={useCase.title} description={useCase.description} path={path} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-6 sm:pt-16">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap gap-2">
        <li><a href="/" class="text-ink">Home</a> <span aria-hidden="true">/</span></li>
        <li><a href="/use-cases/" class="text-ink">Use cases</a> <span aria-hidden="true">/</span></li>
        <li aria-current="page">{useCase.h1}</li>
      </ol>
    </nav>

    <h1 class="mt-6 text-3xl leading-tight font-bold tracking-tight sm:text-4xl">{useCase.h1}</h1>

    <p class="mt-6 text-lg leading-relaxed text-muted">{useCase.outcome}</p>

    <section aria-labelledby="sees-heading" class="mt-12">
      <h2 id="sees-heading" class="text-2xl font-bold tracking-tight">What your agent sees</h2>
      <div class="mt-5 space-y-5 text-lg leading-relaxed text-muted">
        {useCase.agentSees.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section aria-labelledby="guarantees-heading" class="mt-12">
      <h2 id="guarantees-heading" class="text-2xl font-bold tracking-tight">What the program guarantees</h2>
      <ul class="mt-5 list-disc space-y-3 pl-6 text-lg leading-relaxed text-muted">
        {useCase.guarantees.map((g) => <li>{g}</li>)}
      </ul>
    </section>

    <section aria-labelledby="flow-heading" class="mt-12">
      <h2 id="flow-heading" class="text-2xl font-bold tracking-tight">The steps in one picture</h2>
      <figure class="card mt-5 p-4 sm:p-8">
        <FlowDiagram spec={useCase.flow} label={useCase.flowLabel} />
        <figcaption class="mt-4 text-sm text-muted">{useCase.flowCaption}</figcaption>
      </figure>
    </section>

    <section aria-labelledby="install-heading" class="card mt-12 p-6 sm:p-8">
      <h2 id="install-heading" class="text-2xl font-bold tracking-tight">Install it like an app</h2>
      <p class="mt-3 text-muted">
        Install the program once. <code>rein list</code> shows the programs you have, and
        <code>rein agent-context</code> prints the list your agent reads to pick one.
      </p>
      <pre class="mt-5 overflow-x-auto rounded-md border border-line p-4 text-sm"><code>{installLines}</code></pre>
      {useCase.source && (
        <p class="mt-4 text-sm text-muted">
          Source: <a href={useCase.source.href} class="text-ink">{useCase.source.label}</a>
        </p>
      )}
    </section>

    <section aria-labelledby="alpha-heading" class="card mt-12 p-6 sm:p-8">
      <p class="eyebrow">Alpha</p>
      <h2 id="alpha-heading" class="mt-2 text-2xl font-bold tracking-tight">Try this program</h2>
      <p class="mt-3 text-muted">
        Rein is a proof of concept. Syntax and tools can still change. Install the command line tool,
        and write a first program in a few minutes.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={GET_STARTED_HREF} class="btn btn-primary">Get started</a>
        <a href="/docs/" class="btn btn-secondary">Docs</a>
      </div>
    </section>

    <section aria-labelledby="related-heading" class="mt-12">
      <h2 id="related-heading" class="text-2xl font-bold tracking-tight">Related use cases</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        {related.map((u) => (
          <li>
            <a href={`/use-cases/${u.slug}/`} class="card block h-full p-5 no-underline hover:underline">
              <span class="block text-lg font-semibold">{u.h1}</span>
              <span class="mt-2 block text-sm text-muted">{u.teaser}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8"><a href="/use-cases/" class="font-semibold">All use cases</a></p>
    </section>
  </article>
</Base>
