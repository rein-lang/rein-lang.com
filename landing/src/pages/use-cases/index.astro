---
import Base from "../../layouts/Base.astro";
import { GET_STARTED_HREF } from "../../../site.config.mjs";
import { useCases } from "../../data/useCases";
import { absolute, breadcrumbs, website } from "../../data/structuredData";

const path = "/use-cases/";
const title = "Rein use cases: apps for AI agents | Rein";
const description =
  "Apps for AI agents built with Rein: merge pull requests, triage incidents, answer tickets, prioritize a backlog with MoSCoW, and more.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: absolute(path),
    isPartOf: website,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: useCases.map((u, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: u.h1,
        url: absolute(`/use-cases/${u.slug}/`),
      })),
    },
  },
  breadcrumbs([["Use cases", path]]),
];
---

<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-16 sm:px-6 sm:pt-16" aria-labelledby="use-cases-heading">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap gap-2">
        <li><a href="/" class="text-ink">Home</a> <span aria-hidden="true">/</span></li>
        <li aria-current="page">Use cases</li>
      </ol>
    </nav>
    <h1 id="use-cases-heading" class="mt-6 text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
      Apps your agent uses
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      Give your agent apps, not manuals. Each Rein program asks the agent one question at a time, and it cannot
      skip a step. Each page below shows one program, what the agent sees, and what the program guarantees.
    </p>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {useCases.map((u) => (
        <li>
          <a href={`/use-cases/${u.slug}/`} class="card block h-full p-6 no-underline hover:underline">
            <h2 class="text-lg font-semibold">{u.h1}</h2>
            <p class="mt-2 text-muted">{u.teaser}</p>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-12 flex flex-wrap gap-3">
      <a href={GET_STARTED_HREF} class="btn btn-primary">Get started</a>
      <a href="/docs/examples/" class="btn btn-secondary">Example programs</a>
    </div>
  </section>
</Base>
