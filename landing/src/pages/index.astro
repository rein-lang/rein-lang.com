---
import Base from "../layouts/Base.astro";
import FlowDiagram from "../components/FlowDiagram.astro";
import AppsNotManuals from "../components/AppsNotManuals.astro";
import HomeFaq from "../components/HomeFaq.astro";
import { GET_STARTED_HREF, HOME_DESCRIPTION } from "../../site.config.mjs";
import { faqs, faqText } from "../data/faq";
import { absolute, website } from "../data/structuredData";
import { flows } from "../data/flows";
import { useCases } from "../data/useCases";
import { reinVersion } from "../data/docsPages";

const title = "Rein: give your AI coding agent apps, not long manuals";
const description = HOME_DESCRIPTION;
const installCommand = "cargo install rein --locked";
const brewCommand = "brew tap rein-lang/rein https://github.com/rein-lang/rein\nbrew install rein";

// The eight outcomes. Each command is a real rein 0.1.4 command, checked with rein <cmd> --help.
const outcomes = [
  {
    title: "No skipped steps",
    text: "The agent gets the next step only after it answers. No prompt needs a line that says never skip.",
    commands: [],
  },
  {
    title: "The same result each run",
    text: "The same answers lead to the same step, for every agent and every run.",
    commands: [],
  },
  {
    title: "See what happened",
    text: "See the agents that run now, their answers, and the step each run waits on. Graph and debug show the path.",
    commands: ["rein watch", "rein graph", "rein debug"],
  },
  {
    title: "Change it safely",
    text: "Add an option. The checker lists each place that needs a new case.",
    commands: ["rein check"],
  },
  {
    title: "Install, share and update like an app",
    text: "Programs are packages with versions. Install one for your user account, list them, and update them.",
    commands: ["rein install -g <package>", "rein list", "rein update"],
  },
  {
    title: "The agent finds its apps",
    text: "The agent gets the list of installed programs, like a home screen. It starts the one that matches the task.",
    commands: ["rein agent-context"],
  },
  {
    title: "Asks a person when it must",
    text: "A program can stop and ask a person. The typed answer chooses the next step.",
    commands: [],
  },
  {
    title: "Programs call programs",
    text: "One program hands off to another, as one app opens another. Import a program by its entry.",
    commands: [],
  },
];

// One linked graph: the site, the project, the language and its command line tool, and the questions below.
const home = absolute("/");
const project = { "@id": `${home}#organization` };
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { ...website, "@id": `${home}#website`, description, publisher: project },
    {
      "@type": "Organization",
      ...project,
      name: "Rein",
      url: home,
      logo: absolute("/apple-touch-icon.png"),
      sameAs: ["https://github.com/rein-lang"],
    },
    {
      "@type": "ComputerLanguage",
      "@id": `${home}#language`,
      name: "Rein",
      alternateName: "Rein language",
      description,
      url: home,
      sameAs: ["https://github.com/rein-lang/rein"],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${home}#cli`,
      name: "rein",
      description: "The rein command line tool checks, runs, steps, graphs and debugs Rein programs.",
      url: absolute(GET_STARTED_HREF),
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Any",
      softwareVersion: reinVersion(),
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      license: "https://opensource.org/licenses/MIT",
      author: project,
      downloadUrl: "https://github.com/rein-lang/rein/releases",
      sameAs: ["https://github.com/rein-lang/rein"],
    },
    {
      "@type": "FAQPage",
      "@id": `${home}#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faqText(faq) },
      })),
    },
  ],
};
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="px-4 pt-12 pb-16 sm:px-6 sm:pt-20 sm:pb-24" aria-labelledby="hero-heading">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div class="min-w-0">
        <p class="inline-flex items-center rounded-full border border-accent px-3 py-1 text-sm font-semibold text-accent">
          Beta
        </p>
        <h1 id="hero-heading" class="mt-6 text-4xl leading-tight font-bold tracking-tight sm:text-5xl lg:text-6xl">
          Give your agent apps, not manuals.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
          A Rein program asks your agent one question at a time. Each answer leads to the next step, and the agent gets
          that step only after it answers.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={GET_STARTED_HREF} class="btn btn-primary">Get started</a>
          <a href="/docs/" class="btn btn-secondary">Docs</a>
        </div>
        <p class="mt-8 text-sm text-muted">Install the rein command line tool with Homebrew.</p>
        <pre class="card mt-2 overflow-x-auto p-4 text-sm"><code>{brewCommand}</code></pre>
        <p class="mt-4 text-sm text-muted">Or install it with cargo. It needs Rust.</p>
        <pre class="card mt-2 overflow-x-auto p-4 text-sm"><code>{installCommand}</code></pre>
      </div>
      <div class="card min-w-0 p-4 sm:p-6">
        <FlowDiagram
          spec={flows.hero}
          label="Diagram. A decision asks questions, then leads to one of several instructions."
        />
      </div>
    </div>
  </section>

  <AppsNotManuals />

  <!-- Value -->
  <section id="benefits" class="border-t border-line px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="benefits-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="benefits-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">What you get</h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Each outcome comes from the program. You do not add it to the agent's prompt.
      </p>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          outcomes.map((o) => (
            <li class="card flex flex-col gap-3 p-6">
              <h3 class="text-lg font-semibold">{o.title}</h3>
              <p class="text-muted">{o.text}</p>
              {o.commands.length > 0 && (
                <ul class="mt-auto flex flex-wrap gap-2 pt-2">
                  {o.commands.map((c) => (
                    <li>
                      <code class="rounded bg-surface-2 px-2 py-1 text-sm">{c}</code>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="border-t border-line px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="flow-heading">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 id="flow-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Start at main. Answer. Follow the pointers.</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Every program has a main function, its entry point. The agent answers only the questions on its path. It
          follows each pointer until it reaches an instruction.
        </p>
      </div>
      <figure class="card overflow-hidden">
        <img
          src="/images/concept-flow.webp"
          width="1280"
          height="720"
          loading="lazy"
          alt="Four cards in a row, each with question chips above it, linked by a teal line that ends in an instruction. The caption reads: Start at main. Answer. Follow the pointers."
          class="h-auto w-full"
        />
      </figure>
    </div>
  </section>

  <!-- Four ideas -->
  <section class="border-t border-line px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="steps-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="steps-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Four ideas make a program</h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-2">
        <li class="card flex flex-col gap-5 p-5 sm:p-6">
          <figure class="overflow-hidden rounded-xl">
            <img
              src="/images/concept-step-one.webp"
              width="1280"
              height="720"
              loading="lazy"
              alt="A stack of rounded cards, the front one outlined in teal. The caption reads: One decision, one function, one file."
              class="h-auto w-full"
            />
          </figure>
          <div>
            <h3 class="text-xl font-semibold"><span class="text-accent">1.</span> One decision, one file</h3>
            <p class="mt-2 text-muted">
              Each decision is a small function in its own file. The file starts with a description of what it decides.
            </p>
          </div>
        </li>
        <li class="card flex flex-col gap-5 p-5 sm:p-6">
          <figure class="overflow-hidden rounded-xl">
            <img
              src="/images/concept-step-two.webp"
              width="1280"
              height="720"
              loading="lazy"
              alt="A decision card sends three question chips to one point, which leads to three answer options with one ticked. The caption reads: Inputs are questions the agent answers."
              class="h-auto w-full"
            />
          </figure>
          <div>
            <h3 class="text-xl font-semibold"><span class="text-accent">2.</span> Inputs are questions</h3>
            <p class="mt-2 text-muted">
              The agent answers each question from what it sees. Each one is a yes or no, or one of a few options.
            </p>
          </div>
        </li>
        <li class="card flex flex-col gap-5 p-5 sm:p-6">
          <figure class="overflow-hidden rounded-xl">
            <div class="rounded-xl bg-surface-2 p-4">
              <FlowDiagram
                spec={flows.twoMoves}
                label="Diagram. A decision asks yes or no. Yes leads to an instruction. No asks for a case, which leads to a pointer or a template."
              />
            </div>
          </figure>
          <div>
            <h3 class="text-xl font-semibold"><span class="text-accent">3.</span> Two moves in the body</h3>
            <p class="mt-2 text-muted">
              The body branches on an answer, or picks one case from a fixed set. Every case is written out. There are
              no loops, by design, for now.
            </p>
          </div>
        </li>
        <li class="card flex flex-col gap-5 p-5 sm:p-6">
          <figure class="overflow-hidden rounded-xl">
            <img
              src="/images/concept-step-four.webp"
              width="1280"
              height="720"
              loading="lazy"
              alt="A decision card leads to an instruction bubble, and through a teal arrow to the next card. The caption reads: Every path ends in one of two things."
              class="h-auto w-full"
            />
          </figure>
          <div>
            <h3 class="text-xl font-semibold"><span class="text-accent">4.</span> Every path ends in one of two things</h3>
            <p class="mt-2 text-muted">
              An instruction, written out or built from a template such as a delegated task. Or a pointer to the next
              function.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Checker -->
  <section id="guarantees" class="border-t border-line px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="guarantees-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="guarantees-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">A checker reads every program first</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
        Run <code class="rounded bg-surface-2 px-2 py-1 text-base">rein check</code>. It reads your functions and reports
        three kinds of gap, before an agent runs the program.
      </p>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        <li class="card p-6">
          <h3 class="text-lg font-semibold">Every case is handled</h3>
          <p class="mt-2 text-muted">A new option without a case fails the check. Nothing falls back to a silent default.</p>
        </li>
        <li class="card p-6">
          <h3 class="text-lg font-semibold">Every path returns</h3>
          <p class="mt-2 text-muted">A path that ends without an instruction or a pointer fails the check.</p>
        </li>
        <li class="card p-6">
          <h3 class="text-lg font-semibold">Every pointer is real</h3>
          <p class="mt-2 text-muted">A pointer to a function that does not exist fails the check.</p>
        </li>
      </ul>
      <div class="mt-12 grid items-center gap-10 lg:grid-cols-2">
        <figure class="card overflow-hidden">
          <img
            src="/images/concept-checks.webp"
            width="1280"
            height="720"
            loading="lazy"
            alt="Four lines, each ending in a teal check mark, beside an editor-style window with a wavy teal underline. The caption reads: Checked as you type."
            class="h-auto w-full"
          />
        </figure>
        <div>
          <h3 class="text-2xl font-bold tracking-tight">Editor support</h3>
          <p class="mt-4 text-lg leading-relaxed text-muted">
            The language server shows these gaps as you type. Editor support starts with VS Code.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="border-t border-line px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="video-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="video-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Watch the concept</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">A video of about 70 seconds. It shows the four ideas and one program.</p>
      <figure class="card mt-8 overflow-hidden">
        <!--
          TODO: host the concept video (an mp4 built from rein-lang/videos concept/, not committed to this repo)
          on a public video host. The host is not decided yet. When it is, set src on the video below,
          add controls, and add captions that match the narration in rein-lang/videos concept/script.md.
        -->
        <video
          poster="/images/concept-close.webp"
          preload="none"
          playsinline
          width="1280"
          height="720"
          aria-label="Rein concept video, about 70 seconds. Video hosting is not set up yet."
          class="block h-auto w-full"
        ></video>
        <figcaption class="p-4 text-sm text-muted">Concept video coming soon.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Beta notice -->
  <section class="border-t border-line px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="beta-heading">
    <div class="card mx-auto max-w-4xl p-6 sm:p-10">
      <p class="eyebrow">Beta notice</p>
      <h2 id="beta-heading" class="mt-3 text-3xl font-bold tracking-tight">Rein is in beta</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Rein is in beta. Syntax, tools and behavior can still change. Install the command line tool, then
        write a first program in a few minutes.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={GET_STARTED_HREF} class="btn btn-primary">Get started</a>
        <a href="/docs/" class="btn btn-secondary">Docs</a>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section id="use-cases" class="border-t border-line px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="use-cases-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="use-cases-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Use cases</h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">Each page shows one program, step by step.</p>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {useCases.map((u) => (
          <li>
            <a href={`/use-cases/${u.slug}/`} class="card block h-full p-6 no-underline hover:underline">
              <span class="block text-lg font-semibold">{u.h1}</span>
              <span class="mt-2 block text-muted">{u.teaser}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <HomeFaq />
</Base>
