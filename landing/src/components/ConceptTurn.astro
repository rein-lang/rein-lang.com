<!-- Abstract concept diagram for "Rein flips it". A tangled graph collapses into clean decision cards. -->
<svg
  viewBox="0 0 1280 720"
  role="img"
  aria-label="Diagram. A tangled graph of boxes and lines, with an arrow, becomes three clean cards. Two are labelled decision and one is labelled instruction."
  class="block h-auto w-full"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <marker id="turn-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="flow-arrow-head"></path>
    </marker>
  </defs>

  <!-- Tangled graph: before -->
  <g aria-hidden="true">
    <path d="M120 200 L300 150 L460 240 L200 360 L400 380 L110 520 L300 540 L480 520 L250 260 L120 200 M300 150 L250 260 L400 380 M200 360 L110 520 L300 540 M460 240 L400 380 L480 520 M250 260 L200 360" class="flow-edge"></path>
    <path d="M120 200 L200 360 M460 240 L480 520 M400 380 L300 540" class="flow-edge"></path>
    <rect x="92" y="172" width="56" height="56" rx="12" class="flow-card"></rect>
    <rect x="272" y="122" width="56" height="56" rx="12" class="flow-card"></rect>
    <rect x="432" y="212" width="56" height="56" rx="12" class="flow-card"></rect>
    <rect x="172" y="332" width="56" height="56" rx="12" class="flow-card"></rect>
    <rect x="372" y="352" width="56" height="56" rx="12" class="flow-card"></rect>
    <rect x="82" y="492" width="56" height="56" rx="12" class="flow-card"></rect>
    <rect x="272" y="512" width="56" height="56" rx="12" class="flow-card"></rect>
    <rect x="452" y="492" width="56" height="56" rx="12" class="flow-card"></rect>
    <rect x="222" y="232" width="56" height="56" rx="12" class="flow-card"></rect>
  </g>

  <!-- Collapse arrow -->
  <path d="M560 360 L700 360" class="flow-edge flow-edge-accent" marker-end="url(#turn-arrow)"></path>

  <!-- Clean decision cards: after -->
  <g>
    <rect x="760" y="110" width="440" height="160" rx="22" class="flow-card"></rect>
    <text x="796" y="176" class="turn-title">decision</text>
    <rect x="796" y="212" width="368" height="18" rx="9" class="flow-bar"></rect>
    <rect x="796" y="242" width="270" height="18" rx="9" class="flow-bar"></rect>
  </g>
  <path d="M980 270 L980 290" class="flow-edge"></path>
  <g>
    <rect x="760" y="290" width="440" height="160" rx="22" class="flow-card"></rect>
    <text x="796" y="356" class="turn-title">decision</text>
    <rect x="796" y="392" width="368" height="18" rx="9" class="flow-bar"></rect>
    <rect x="796" y="422" width="270" height="18" rx="9" class="flow-bar"></rect>
  </g>
  <path d="M980 450 L980 470" class="flow-edge"></path>
  <g>
    <rect x="760" y="470" width="440" height="160" rx="22" class="flow-pill-question"></rect>
    <text x="796" y="536" class="turn-title">instruction</text>
    <rect x="796" y="572" width="368" height="18" rx="9" class="flow-bar"></rect>
    <rect x="796" y="602" width="270" height="18" rx="9" class="flow-bar"></rect>
  </g>
</svg>
